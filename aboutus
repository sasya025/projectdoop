/* SOLVEY PREMIUM ABOUT PAGE */
/* ========================= */

.about-container {
  min-height: 100vh;
  padding: 120px 6vw 100px 6vw;
  background: radial-gradient(circle at top left, #1a1a40, #000000 60%);
  color: white;
  position: relative;
  overflow: hidden;
}

/* Glow Effect */
.about-container::before {
  content: "";
  position: absolute;
  width: 500px;
  height: 500px;
  background: radial-gradient(circle, #7873f5, transparent 70%);
  top: -150px;
  left: -150px;
  opacity: 0.15;
  filter: blur(40px);
  z-index: 0;
}

.about-container * {
  position: relative;
  z-index: 1;
}

/* HERO */
.about-hero {
  text-align: center;
  margin-bottom: 100px;
}

.about-hero h1 {
  font-size: 52px;
  background: linear-gradient(45deg, #ff6ec4, #7873f5);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  margin-bottom: 20px;
}

.about-hero p {
  max-width: 750px;
  margin: 0 auto;
  font-size: 18px;
  color: #bbbbbb;
  line-height: 1.8;
}

/* SECTION */
.about-section {
  text-align: center;
  max-width: 900px;
  margin: 0 auto 100px auto;
}

.about-section h2 {
  font-size: 36px;
  margin-bottom: 20px;
  position: relative;
}

.about-section h2::after {
  content: "";
  width: 80px;
  height: 3px;
  background: linear-gradient(45deg, #ff6ec4, #7873f5);
  display: block;
  margin: 10px auto 0 auto;
  border-radius: 5px;
}

.about-section p {
  font-size: 18px;
  color: #cccccc;
  line-height: 1.8;
}

/* FEATURES */
.about-features {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 40px;
  margin-bottom: 100px;
}

.feature-card {
  background: rgba(255, 255, 255, 0.05);
  padding: 35px;
  border-radius: 20px;
  transition: 0.4s ease;
  border: 1px solid rgba(255, 255, 255, 0.08);
}

.feature-card:hover {
  transform: translateY(-12px);
  box-shadow: 0 0 35px rgba(120, 115, 245, 0.4);
}

.feature-card h3 {
  margin-bottom: 15px;
  font-size: 20px;
}

.feature-card p {
  color: #bbbbbb;
  line-height: 1.7;
}

/* COINS SECTION */
.coins-section {
  text-align: center;
  margin-bottom: 100px;
}

.coins-section h2 {
  font-size: 36px;
  margin-bottom: 15px;
  color: #facc15;
}

.coins-section p {
  max-width: 700px;
  margin: 0 auto 50px auto;
  color: #dddddd;
}

.coins-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 40px;
}

.coin-card {
  background: rgba(255, 255, 255, 0.05);
  padding: 35px;
  border-radius: 20px;
  transition: 0.4s ease;
  border: 1px solid rgba(255, 255, 255, 0.08);
}

.coin-card:hover {
  transform: translateY(-12px);
  box-shadow: 0 0 35px rgba(250, 204, 21, 0.4);
}

.coin-card.highlight {
  border: 2px solid #facc15;
}

/* CTA */
.about-cta {
  text-align: center;
  padding: 60px 30px;
  background: linear-gradient(45deg, #ff6ec4, #7873f5);
  border-radius: 20px;
}

.about-cta h2 {
  margin-bottom: 10px;
}

.cta-btn {
  margin-top: 20px;
  padding: 12px 28px;
  border: none;
  border-radius: 8px;
  background: white;
  color: #1a1a40;
  font-weight: 600;
  cursor: pointer;
  transition: 0.3s ease;
}

.cta-btn:hover {
  transform: scale(1.05);
}

/* RESPONSIVE */
@media (max-width: 768px) {
  .about-hero h1 {
    font-size: 38px;
  }

  .about-section h2,
  .coins-section h2 {
    font-size: 28px;
  }
}



